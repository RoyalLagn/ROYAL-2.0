modules = ["nodejs-20", "web", "python-base-3.13"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm install --legacy-peer-deps --prefer-offline && node scripts/patch-expo.js && EXPO_PACKAGER_PROXY_URL=https://$REPLIT_EXPO_DEV_DOMAIN npx expo start --web --port 5000 --host localhost"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[[ports]]
localPort = 8081
externalPort = 8081

[userenv]

[userenv.shared]
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME = "hp6vu8o9"
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET = "royallagn_uploads"
EXPO_PUBLIC_SUPABASE_URL = "https://fymdrjcinqvmjthdwrtd.supabase.co"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 240000

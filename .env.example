# Required Supabase public runtime configuration
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Required Cloudinary unsigned-upload configuration
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Optional sharing links
EXPO_PUBLIC_PLAY_STORE_URL=
EXPO_PUBLIC_APP_URL=
# Recommended production website base for shareable vendor-profile links.
EXPO_PUBLIC_WEB_APP_URL=

# Supabase Edge Function secrets (set with `supabase secrets set`; never add
# these to an EXPO_PUBLIC_ variable or a production client bundle).
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_TEST_WEBHOOK_SECRET=
SUBSCRIPTION_CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# Optional preferred Government of India PIN-code provider configuration for
# the lookup-india-pincode Edge Function. When omitted, the function uses its
# modular no-key fallback provider.
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_PINCODE_RESOURCE_ID=
PINCODE_API_BASE_URL=https://api.postalpincode.in/pincode

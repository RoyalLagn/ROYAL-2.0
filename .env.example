# Required Supabase public runtime configuration
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Required public Cloudinary upload configuration used by the client.
# Keep API secrets/server credentials out of EXPO_PUBLIC_ variables.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Bunny Stream library identifier is public and is used by the web iframe
# player. Storage/API credentials must remain server-side Edge secrets.
EXPO_PUBLIC_BUNNY_STREAM_LIBRARY_ID=

# Optional sharing links
# Defaults to the RoyalLagn Play Store listing (com.royallagn.app) when unset.
EXPO_PUBLIC_PLAY_STORE_URL=
# Set once the iOS build is published; defaults to the App Store homepage when unset.
EXPO_PUBLIC_APP_STORE_URL=
EXPO_PUBLIC_APP_URL=
# Recommended production website base for shareable vendor-profile links.
EXPO_PUBLIC_WEB_APP_URL=

# DEVELOPMENT ONLY. Set to "true" locally to skip the Admin MFA (Microsoft
# Authenticator) prompt and reach /admin-dashboard with just email+password.
# Ignored unless __DEV__ is true AND the app is served from
# localhost/127.0.0.1/::1 (see services/adminMfaPolicy.ts) — has no effect in
# a production build regardless of this value. Only bypasses the client-side
# UI gate: your session still lacks aal2, so real RLS-protected admin queries
# stay blocked server-side until you complete a real TOTP verification once.
# Leave unset/false to keep the normal MFA prompt.
EXPO_PUBLIC_ADMIN_MFA_DEV_BYPASS=

# Supabase Edge Function secrets (set with `supabase secrets set`; never add
# these to an EXPO_PUBLIC_ variable or a production client bundle).
# Bunny Storage (S3-compatible API) and Stream secrets.
BUNNY_STORAGE_S3_ENDPOINT=
BUNNY_STORAGE_ACCESS_KEY_ID=
BUNNY_STORAGE_SECRET_ACCESS_KEY=
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_CDN_HOSTNAME=
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_CDN_HOSTNAME=
BUNNY_STREAM_API_KEY=

# Razorpay test credentials. Configure these as Supabase Edge Function
# secrets. Never prefix the secret values with EXPO_PUBLIC_. The checkout Key
# ID is returned to the authenticated client by create-razorpay-order.
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
SUBSCRIPTION_CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# Optional preferred Government of India PIN-code provider configuration for
# the lookup-india-pincode Edge Function. When omitted, the function uses its
# modular no-key fallback provider.
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_PINCODE_RESOURCE_ID=
PINCODE_API_BASE_URL=https://api.postalpincode.in/pincode

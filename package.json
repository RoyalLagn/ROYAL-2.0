{
  "name": "royallagn",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "postinstall": "node scripts/patch-css-interop-safe-area.mjs",
    "start": "expo start",
    "start:go": "expo start --go --lan --clear",
    "start:phone": "expo start --go --tunnel --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web --output-dir dist-web",
    "serve:web": "npx --yes serve -l 5055 dist-web",
    "prebuild:android": "expo prebuild --platform android --clean",
    "build:apk": "cd android && node -e \"process.env.NODE_ENV='production';require('child_process').execSync((process.platform==='win32'?'gradlew.bat':'./gradlew')+' assembleRelease',{stdio:'inherit',env:process.env})\"",
    "lint": "expo lint",
    "test:profile-smoke": "node scripts/smoke-profile-propagation.mjs",
    "test:profile-e2e": "node --env-file=.env scripts/e2e-profile-propagation.mjs",
    "test:subscriptions": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-subscription-domain.mjs",
    "test:packages": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-package-domain.mjs",
    "test:contacts": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-contact-actions.mjs",
    "test:external-links": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-external-link-normalization.mjs",
    "test:locations": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-location-domain.mjs",
    "test:location-discovery": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-location-discovery-domain.mjs",
    "locations:import-india-post": "node --env-file=.env scripts/import-india-post-pincodes.mjs",
    "test:regression-guards": "node scripts/test-regression-guards.mjs",
    "test:bunny-media": "node scripts/test-bunny-media-guards.mjs",
    "test:geo-pincode-mapping": "node scripts/test-geo-pincode-taluka-mapping.mjs",
    "test:e2e:pincode-mapping": "playwright test tests/e2e/pincode-taluka-mapping.spec.ts",
    "test:auth-validation": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-auth-validation.mjs",
    "test:marketing-card-pdf": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-marketing-card-pdf.mjs",
    "test:vendor-readiness": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-vendor-readiness.mjs",
    "test:reviews": "node scripts/test-vendor-reviews-domain.mjs",
    "test:transactions": "node scripts/test-vendor-transactions-domain.mjs",
    "test:smoke": "node scripts/run-smoke-tests.mjs",
    "test:referral-e2e": "node scripts/test-referral-system-e2e.mjs",
    "test:referral-withdrawals": "node scripts/test-referral-withdrawals-phase1.mjs",
    "test:team-portal": "node scripts/test-team-portal-phase2.mjs",
    "sitemap:generate": "node scripts/generate-sitemap.mjs"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo/metro-runtime": "6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "2.6.5",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.110.7",
    "chart.js": "^4.5.1",
    "expo": "~54.0.37",
    "expo-blur": "~15.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-video": "~3.0.16",
    "expo-video-thumbnails": "~10.0.8",
    "expo-web-browser": "~15.0.11",
    "gsap": "^3.15.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "lucide-react-native": "0.510.0",
    "nativewind": "4.2.1",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-compressor": "^2.0.3",
    "react-native-css-interop": "0.2.1",
    "react-native-gesture-handler": "2.28.0",
    "react-native-nitro-modules": "^0.36.3",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-razorpay": "^2.3.1",
    "react-native-reanimated": "4.1.3",
    "react-native-safe-area-context": "5.6.1",
    "react-native-screens": "4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "0.21.1",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "3.4.18",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@playwright/test": "^1.62.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.1.17",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "9.37.0",
    "eslint-config-expo": "10.0.0",
    "supabase": "^2.109.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "private": true
}

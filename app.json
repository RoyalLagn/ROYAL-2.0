{
  "expo": {
    "name": "RoyalLagn",
    "slug": "royallagn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "royallagn",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.royallagn.app",
      "buildNumber": "1"
    },
    "android": {
      "versionCode": 3,
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.royallagn.app"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 320,
          "resizeMode": "contain",
          "backgroundColor": "#FAD1CE"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow RoyalLagn to select photos and videos for profiles, portfolios, reviews, and Clips.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-video",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/app-icon.png",
          "color": "#E91E63",
          "sounds": [],
          "defaultChannel": "default"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true,
          "default": false
        }
      },
      "eas": {
        "projectId": "3a048547-7617-42b0-ab17-0842bba8fefe"
      }
    }
  }
}

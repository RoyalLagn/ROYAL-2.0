{
  "framework": null,
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run sitemap:generate && npx expo export -p web",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/vendors/:slug",
      "destination": "/vendor/:slug",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/_expo/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(service-worker\\.js|admin-service-worker\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/vendors",
      "destination": "/api/legacy-vendor"
    },
    {
      "source": "/VendorsProfile",
      "destination": "/api/legacy-vendor"
    },
    {
      "source": "/VendorsListing",
      "destination": "/api/legacy-listing"
    },
    {
      "source": "/((?!api/|_expo/|assets/|favicon\\.ico|robots\\.txt|sitemap\\.xml|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}

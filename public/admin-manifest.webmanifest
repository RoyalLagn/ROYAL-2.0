  "short_name": "RL Admin",
  "description": "Secure RoyalLagn marketplace administration portal.",
  "start_url": "/AdminLogin?source=pwa",
  "scope": "/",
  "display": "standalone",
  "background_color": "#FFF8F5",
  "theme_color": "#06234D",
  "orientation": "any",
  "icons": [
    {
      "src": "/admin-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/admin-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/admin-icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "url": "/admin-dashboard",
      "icons": [{ "src": "/admin-icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Vendor approvals",
      "short_name": "Approvals",
      "url": "/VendorApplications",
      "icons": [{ "src": "/admin-icon-192.png", "sizes": "192x192" }]
    }
  ]
}
